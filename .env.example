# segui_bus — example configuration
#
# Copy to .env and adjust. Never commit the real .env.
# Version is NOT configured here: it is read from the VERSION file at the repo
# root (see docs/versioning.md). The HTTP client header is assembled as:
#
#   X-BusOne-Client: segui_bus/<VERSION> <BUSONE_CLIENT_CONTACT>
#   X-BusOne-Use:    <BUSONE_USE>
#
# NOTE attribution line — messaggio attribuzione dati
# BusOne (https://busone.app) e la fonte originale (SETA S.p.A.)
# Required by https://proxy.busone.app/#data-terms. Keep this line in every
# user-visible output (Telegram message, Home Assistant attributes, logs).
# This marker must stay grep-able: "# NOTE attribution line".

BUSONE_BASE_URL=https://proxy.busone.app
BUSONE_NAMESPACE=seta-pc
BUSONE_USE=personal
BUSONE_CLIENT_CONTACT=gh/gnoccoalpesto

# WebSocket-first integration (see docs/research/2026-10-20-busone-proxy-seta-pc.md §4)
# ws_path is a suffix: the full URL is built as <base>/<namespace><path>.
BUSONE_WS_PATH=/ws
BUSONE_FETCH_TIMEOUT_S=10
BUSONE_STALE_AFTER_S=120

# Degraded mode only: used when the WebSocket is unavailable
BUSONE_FALLBACK_VP_INTERVAL_S=30
BUSONE_FALLBACK_TU_INTERVAL_S=15

# Tests only: enables the live, five-minute observation test (MultiBusTest).
# Leave it unset to keep the test suite offline and fast.
# SEGUI_BUS_LIVE=1

# Where the static gtfs.zip cache lives. Default: <repo>/.cache
# BUSONE_CACHE_DIR=
